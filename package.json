{
  "name": "codex-traffic-studio",
  "version": "2.4.0",
  "description": "跨 Windows、macOS 和 Linux 的本地 Codex 流量统计桌面应用",
  "private": true,
  "keywords": ["codex", "electron", "token-usage", "tailscale", "analytics"],
  "main": "src/main.js",
  "desktopName": "codex-traffic-studio.desktop",
  "author": "zzs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/stats.js && node --check src/sync-server.js && node --check src/updater.js && node --check static/app.js",
    "test": "node --test",
    "test:ui": "electron scripts/verify-ui.js",
    "verify:release": "node scripts/verify-release-tag.js",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.zzs.codextrafficstudio",
    "productName": "Codex 流量统计",
    "asar": true,
    "publish": [{ "provider": "github", "owner": "USTC-Astar", "repo": "Token_consumption_statistics" }],
    "files": [
      "src/**/*",
      "static/**/*",
      "build/icon.*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "artifactName": "Codex-Traffic-Studio-${version}-${arch}.${ext}"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Codex-Traffic-Studio-Setup-${version}-${arch}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Codex-Traffic-Studio-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "artifactName": "Codex-Traffic-Studio-${version}-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "用于通过 Tailscale 读取你授权的其他设备上的 Codex 聚合统计。"
      }
    }
  }
}
